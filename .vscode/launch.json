		{
			"type": "lldb",
			"request": "launch",
			"name": "Debug (release)",
			"cargo": {
				"args": ["build", "--release", "--manifest-path=./src/Cargo.toml"]
			},
			"preLaunchTask": "frontend:build"
		}
	]
}
