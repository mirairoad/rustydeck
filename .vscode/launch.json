{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "lldb",
			"request": "launch",
			"name": "Debug (debug)",
			"cargo": {
				"args": ["build", "--manifest-path=./src/Cargo.toml", "--no-default-features"]
			},
			"preLaunchTask": "frontend:dev"
